{
  "name": "rnr-rent-car-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:local": "node scripts/local-db.js",
    "db:migrate": "prisma migrate deploy",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke.js && node tests/operations-smoke.js && node tests/seed-idempotence.js",
    "test:browser": "cd .. && node server/tests/browser-smoke.js && node server/tests/browser-booking.js && node server/tests/browser-regression.js",
    "test:regression": "node tests/regression-smoke.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright": "^1.64.1",
    "prisma": "^5.22.0"
  }
}
